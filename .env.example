# Copy to .env.local and fill in. Never commit real values.

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-11-27
# Editor token: download limit, download counts, webhooks (server only)
SANITY_API_WRITE_TOKEN=
# Scripts only (fallback token for scripts/)
SANITY_API_TOKEN=
# Signs /api/webhooks/sanity (Cloudinary cleanup on delete)
SANITY_WEBHOOK_SECRET=

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Studio-only routes (Gemini, Cloudinary delete) ---
GOOGLE_API_KEY=
ADMIN_API_SECRET=

# --- Email + signed download links ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="The Pixel Prince <hello@thepixelprince.com>"
DOWNLOAD_LINK_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.thepixelprince.com

# --- Fourthwall ---
# Checkout host, no protocol. Empty = Buy buttons show "Coming soon"
NEXT_PUBLIC_FOURTHWALL_CHECKOUT_DOMAIN=
# Public storefront token for the on-site cart (same value as FOURTHWALL_STOREFRONT_TOKEN)
NEXT_PUBLIC_FOURTHWALL_STOREFRONT_TOKEN=
FOURTHWALL_WEBHOOK_SECRET=

# --- Analytics / verification (optional) ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_PINTEREST_DOMAIN_VERIFY=

# --- Scripts only, never in Vercel ---
FOURTHWALL_STOREFRONT_TOKEN=
FOURTHWALL_API_USER=
FOURTHWALL_API_PASSWORD=
# scripts/check-prices.ts dashboard links (defaults to the shop domain)
FOURTHWALL_ADMIN_SLUG=
# scripts/test-webhook.ts target
WEBHOOK_URL=

# --- Development only: skip the email gate (ignored in production) ---
# DISABLE_DOWNLOAD_LIMIT=true
